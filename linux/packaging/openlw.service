# OpenLW user systemd service: daemon serves the session's PipeWire nodes
# (ADR 0009). Installed in /usr/lib/systemd/user/; enable with:
#   systemctl --user enable --now openlw.service
# Without an active session (dedicated machine): loginctl enable-linger <user>.
[Unit]
Description=OpenLW: Livewire and AES67 audio
After=pipewire.service
Wants=pipewire.service

[Service]
ExecStart=/usr/bin/lw-daemon run --config %E/openlw/lw-daemon.json --init-config --control
Restart=on-failure
RestartSec=2
# Real-time (SCHED_FIFO): limit granted through pipewire/audio group (limits.d); otherwise
# daemon uses time-sharing and reports it in the log.
LimitRTPRIO=70

[Install]
WantedBy=default.target
