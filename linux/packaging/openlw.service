# Service OpenLW, unité systemd utilisateur : le daemon sert lui-même les nœuds PipeWire de la
# session (ADR 0009). Installée dans /usr/lib/systemd/user/ ; activation :
#   systemctl --user enable --now openlw.service
# Sans session ouverte (machine dédiée) : loginctl enable-linger <utilisateur>.
[Unit]
Description=OpenLW : audio Livewire et AES67
After=pipewire.service
Wants=pipewire.service

[Service]
ExecStart=/usr/bin/lw-daemon run --config %E/openlw/lw-daemon.json --init-config --control
Restart=on-failure
RestartSec=2
# Temps réel (SCHED_FIFO) : limite accordée par le groupe pipewire ou audio (limits.d) ; sinon le
# daemon tourne en temps partagé et le signale dans le journal.
LimitRTPRIO=70

[Install]
WantedBy=default.target
