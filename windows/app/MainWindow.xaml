<?xml version="1.0" encoding="utf-8"?>
<!-- Main window: Livewire network, audio driver, input patch matrix, transmitted outputs,
     advanced settings. The network service is never shown: the app talks about network,
     channels and device (same structure as the macOS app). -->
<Window x:Class="OpenLW.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenLW">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleBarText" Text="OpenLW" Margin="16,10,0,0"
                   Style="{StaticResource CaptionTextBlockStyle}" />
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="12" Padding="20,4,20,20" MaxWidth="1100" HorizontalAlignment="Stretch">

                <!-- Livewire network -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Livewire network" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse x:Name="StateDot" Width="10" Height="10" VerticalAlignment="Center"
                                     Fill="{ThemeResource ControlStrongFillColorDefaultBrush}" />
                            <TextBlock x:Name="StateText" Text="Connecting to the OpenLW service…" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Interface:" VerticalAlignment="Center" />
                            <ComboBox x:Name="IfaceCombo" MinWidth="340" SelectionChanged="IfaceChanged" />
                            <CheckBox x:Name="AdvertiseCheck" Content="Advertise outputs on the network"
                                      Margin="16,0,0,0" Click="AdvertiseClicked" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Clock: the computer's own. Drift relative to other devices is compensated automatically." />
                        <InfoBar x:Name="MessageBar" Severity="Error" IsOpen="False" IsClosable="True" />
                    </StackPanel>
                </Border>

                <!-- Audio driver (ASIO): logo near every ASIO mention (Steinberg usage guidelines). -->
                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="8">
                            <TextBlock Text="Audio driver" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock TextWrapping="Wrap"
                                       Text="In your audio software, select the ASIO® driver “OpenLW”. Only one application can use it at a time; its inputs and outputs are the ones set below." />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Applications without ASIO support (browsers, video conferencing) can't see OpenLW." />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="ASIO is a registered trademark of Steinberg Media Technologies GmbH." />
                        </StackPanel>
                        <!-- Source set in code: file next to the executable (unpackaged app). -->
                        <Image x:Name="AsioLogo" Grid.Column="1" Height="64" VerticalAlignment="Top" />
                    </Grid>
                </Border>

                <!-- Inputs: network to computer -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Inputs (network to computer)" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Received Livewire channels:" VerticalAlignment="Center" />
                            <ComboBox x:Name="InCount" MinWidth="220" SelectionChanged="ChannelCountChanged" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Click a cell to send the source to that input pair of the OpenLW driver. Click it again to release the pair. The headphone button plays the source on the Windows output without patching it." />
                        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
                            <ContentControl x:Name="GridHost" HorizontalContentAlignment="Left" />
                        </ScrollViewer>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Unadvertised source, channel:" VerticalAlignment="Center" />
                            <TextBox x:Name="ManualChannel" PlaceholderText="1 to 32766" Width="110" KeyDown="ManualKeyDown" />
                            <ComboBox x:Name="ManualKind" SelectedIndex="0">
                                <x:String>Stereo</x:String>
                                <x:String>Backfeed (To Source)</x:String>
                                <x:String>8-channel surround</x:String>
                            </ComboBox>
                            <Button Content="Add to grid" Click="AddManualClicked" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Outputs: computer to network -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Outputs (computer to network)" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Transmitted Livewire channels:" VerticalAlignment="Center" />
                            <ComboBox x:Name="OutCount" MinWidth="220" SelectionChanged="ChannelCountChanged" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Each output pair of the OpenLW driver is transmitted on the Livewire channel of your choice, under the name shown. Changes apply when Transmit is checked." />
                        <StackPanel x:Name="OutputRows" Spacing="6" />
                    </StackPanel>
                </Border>

                <!-- Advanced settings -->
                <Expander x:Name="AdvancedExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                          Header="Advanced settings: advertised name, receive latency, network priority"
                          Expanding="AdvancedExpanding" Collapsed="AdvancedCollapsed">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="4">
                            <TextBox x:Name="TerminalName" Header="Advertised name" Width="300" HorizontalAlignment="Left"
                                     KeyDown="TerminalKeyDown" LostFocus="TerminalLostFocus" />
                            <TextBlock Style="{StaticResource Hint}" MaxWidth="600" HorizontalAlignment="Left"
                                       Text="Name shown by other Livewire devices, 32 characters at most, accents replaced. Empty: the computer name. Press Enter to apply." />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <ComboBox x:Name="LatencyCombo" Header="Receive latency" MinWidth="360" SelectionChanged="LatencyChanged" />
                            <TextBlock Style="{StaticResource Hint}" MaxWidth="600" HorizontalAlignment="Left"
                                       Text="Buffering added to that of the recording software. The lower the latency, the more likely a network or computer delay is to cause a brief dropout." />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <ComboBox x:Name="DscpCombo" Header="Network priority (DSCP)" MinWidth="360" SelectionChanged="DscpChanged" />
                            <TextBlock Style="{StaticResource Hint}" MaxWidth="600" HorizontalAlignment="Left"
                                       Text="Marking of transmitted audio streams. Choose the value expected by your switches' QoS." />
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
