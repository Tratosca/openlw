<?xml version="1.0" encoding="utf-8"?>
<!-- Main window: Livewire network, audio driver, input patch matrix, transmitted outputs,
     advanced settings. The network service is never shown: the app talks about network,
     channels and device (same structure as the macOS app). -->
<Window x:Class="OpenLW.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenLW">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleBarText" Text="OpenLW" Margin="16,10,0,0"
                   Style="{StaticResource CaptionTextBlockStyle}" />
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="12" Padding="20,4,20,20" MaxWidth="1100" HorizontalAlignment="Stretch">

                <!-- Livewire network -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Réseau Livewire" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse x:Name="StateDot" Width="10" Height="10" VerticalAlignment="Center"
                                     Fill="{ThemeResource ControlStrongFillColorDefaultBrush}" />
                            <TextBlock x:Name="StateText" Text="Connexion au service OpenLW…" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Interface :" VerticalAlignment="Center" />
                            <ComboBox x:Name="IfaceCombo" MinWidth="340" SelectionChanged="IfaceChanged" />
                            <CheckBox x:Name="AdvertiseCheck" Content="Annoncer les sorties sur le réseau"
                                      Margin="16,0,0,0" Click="AdvertiseClicked" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Horloge : celle de l'ordinateur. Les écarts avec les autres appareils sont compensés automatiquement." />
                        <InfoBar x:Name="MessageBar" Severity="Error" IsOpen="False" IsClosable="True" />
                    </StackPanel>
                </Border>

                <!-- Audio driver (ASIO): logo near every ASIO mention (Steinberg usage guidelines). -->
                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="8">
                            <TextBlock Text="Pilote audio" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock TextWrapping="Wrap"
                                       Text="Dans votre logiciel audio, choisissez le pilote ASIO® « OpenLW ». Un seul logiciel l'utilise à la fois ; ses entrées et ses sorties sont celles réglées ci-dessous." />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Les applications sans ASIO (navigateurs, visioconférence) ne voient pas OpenLW." />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="ASIO is a registered trademark of Steinberg Media Technologies GmbH." />
                        </StackPanel>
                        <!-- Source set in code: file next to the executable (unpackaged app). -->
                        <Image x:Name="AsioLogo" Grid.Column="1" Height="64" VerticalAlignment="Top" />
                    </Grid>
                </Border>

                <!-- Inputs: network to computer -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Entrées (réseau vers ordinateur)" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Canaux Livewire reçus :" VerticalAlignment="Center" />
                            <ComboBox x:Name="InCount" MinWidth="220" SelectionChanged="ChannelCountChanged" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Cliquez une case pour envoyer la source sur cette paire d'entrées du pilote OpenLW. Cliquez à nouveau pour la libérer. Le bouton casque fait écouter la source sur la sortie de Windows, sans la patcher." />
                        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
                            <ContentControl x:Name="GridHost" HorizontalContentAlignment="Left" />
                        </ScrollViewer>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Source non annoncée, canal :" VerticalAlignment="Center" />
                            <TextBox x:Name="ManualChannel" PlaceholderText="1 à 32766" Width="110" KeyDown="ManualKeyDown" />
                            <ComboBox x:Name="ManualKind" SelectedIndex="0">
                                <x:String>Stéréo</x:String>
                                <x:String>Retour (To Source)</x:String>
                                <x:String>Surround 8 canaux</x:String>
                            </ComboBox>
                            <Button Content="Ajouter à la grille" Click="AddManualClicked" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Outputs: computer to network -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Sorties (ordinateur vers réseau)" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Canaux Livewire diffusés :" VerticalAlignment="Center" />
                            <ComboBox x:Name="OutCount" MinWidth="220" SelectionChanged="ChannelCountChanged" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Chaque paire de sorties du pilote OpenLW est diffusée sur le canal Livewire de votre choix, sous le nom indiqué. Une modification s'applique quand la case Diffuser est cochée." />
                        <StackPanel x:Name="OutputRows" Spacing="6" />
                    </StackPanel>
                </Border>

                <!-- Advanced settings -->
                <Expander x:Name="AdvancedExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                          Header="Réglages avancés : nom annoncé, latence de réception, priorité réseau"
                          Expanding="AdvancedExpanding" Collapsed="AdvancedCollapsed">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="4">
                            <TextBox x:Name="TerminalName" Header="Nom annoncé" Width="300" HorizontalAlignment="Left"
                                     KeyDown="TerminalKeyDown" LostFocus="TerminalLostFocus" />
                            <TextBlock Style="{StaticResource Hint}" MaxWidth="600" HorizontalAlignment="Left"
                                       Text="Nom affiché par les autres appareils Livewire, 32 caractères au plus, accents remplacés. Vide : nom de l'ordinateur. Validez avec Entrée." />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <ComboBox x:Name="LatencyCombo" Header="Latence de réception" MinWidth="360" SelectionChanged="LatencyChanged" />
                            <TextBlock Style="{StaticResource Hint}" MaxWidth="600" HorizontalAlignment="Left"
                                       Text="Tampons ajoutés à celui du logiciel qui enregistre. Plus la latence est faible, plus un retard du réseau ou de l'ordinateur risque de provoquer une coupure brève." />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <ComboBox x:Name="DscpCombo" Header="Priorité réseau (DSCP)" MinWidth="360" SelectionChanged="DscpChanged" />
                            <TextBlock Style="{StaticResource Hint}" MaxWidth="600" HorizontalAlignment="Left"
                                       Text="Marquage des flux audio émis. Choisissez la valeur prévue par la QoS de vos commutateurs." />
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
