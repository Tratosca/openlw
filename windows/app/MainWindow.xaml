<?xml version="1.0" encoding="utf-8"?>
<!-- Main window: Livewire network, audio driver, input patch matrix, transmitted outputs,
     advanced settings. The network service is never shown: the app talks about network,
     channels and device (same structure as the macOS app). Texts: x:Uid resources in
     Strings\<language>\Resources.resw. -->
<Window x:Class="OpenLW.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenLW">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleBarText" Text="OpenLW" Margin="16,10,0,0"
                   Style="{StaticResource CaptionTextBlockStyle}" />
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="12" Padding="20,4,20,20" MaxWidth="1100" HorizontalAlignment="Stretch">

                <!-- Livewire network -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="NetworkTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse x:Name="StateDot" Width="10" Height="10" VerticalAlignment="Center"
                                     Fill="{ThemeResource ControlStrongFillColorDefaultBrush}" />
                            <TextBlock x:Name="StateText" x:Uid="StateConnecting" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Uid="InterfaceLabel" VerticalAlignment="Center" />
                            <ComboBox x:Name="IfaceCombo" MinWidth="340" SelectionChanged="IfaceChanged" />
                            <CheckBox x:Name="AdvertiseCheck" x:Uid="AdvertiseCheck"
                                      Margin="16,0,0,0" Click="AdvertiseClicked" />
                        </StackPanel>
                        <TextBlock x:Uid="ClockHint" Style="{StaticResource Hint}" />
                        <InfoBar x:Name="MessageBar" Severity="Error" IsOpen="False" IsClosable="True" />
                    </StackPanel>
                </Border>

                <!-- Audio driver (ASIO): logo near every ASIO mention (Steinberg usage guidelines). -->
                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="DriverTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock x:Uid="DriverText" TextWrapping="Wrap" />
                            <TextBlock x:Uid="DriverHint" Style="{StaticResource Hint}" />
                            <TextBlock x:Uid="AsioTrademark" Style="{StaticResource Hint}" />
                        </StackPanel>
                        <!-- Source set in code: file next to the executable (unpackaged app). -->
                        <Image x:Name="AsioLogo" Grid.Column="1" Height="64" VerticalAlignment="Top" />
                    </Grid>
                </Border>

                <!-- Inputs: network to computer -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="InputsTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Uid="InCountLabel" VerticalAlignment="Center" />
                            <ComboBox x:Name="InCount" MinWidth="220" SelectionChanged="ChannelCountChanged" />
                        </StackPanel>
                        <TextBlock x:Uid="InputsHint" Style="{StaticResource Hint}" />
                        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
                            <ContentControl x:Name="GridHost" HorizontalContentAlignment="Left" />
                        </ScrollViewer>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Uid="ManualLabel" VerticalAlignment="Center" />
                            <TextBox x:Name="ManualChannel" x:Uid="ManualChannel" Width="110" KeyDown="ManualKeyDown" />
                            <ComboBox x:Name="ManualKind" SelectedIndex="0">
                                <ComboBoxItem x:Uid="KindStereo" />
                                <ComboBoxItem x:Uid="KindBackfeed" />
                                <ComboBoxItem x:Uid="KindSurround" />
                            </ComboBox>
                            <Button x:Uid="AddManual" Click="AddManualClicked" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Outputs: computer to network -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="OutputsTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Uid="OutCountLabel" VerticalAlignment="Center" />
                            <ComboBox x:Name="OutCount" MinWidth="220" SelectionChanged="ChannelCountChanged" />
                        </StackPanel>
                        <TextBlock x:Uid="OutputsHint" Style="{StaticResource Hint}" />
                        <StackPanel x:Name="OutputRows" Spacing="6" />
                    </StackPanel>
                </Border>

                <!-- Advanced settings -->
                <Expander x:Name="AdvancedExpander" x:Uid="AdvancedExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                          Expanding="AdvancedExpanding" Collapsed="AdvancedCollapsed">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="4">
                            <TextBox x:Name="TerminalName" x:Uid="TerminalName" Width="300" HorizontalAlignment="Left"
                                     KeyDown="TerminalKeyDown" LostFocus="TerminalLostFocus" />
                            <TextBlock x:Uid="TerminalHint" Style="{StaticResource Hint}" MaxWidth="600" HorizontalAlignment="Left" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <ComboBox x:Name="LatencyCombo" x:Uid="LatencyCombo" MinWidth="360" SelectionChanged="LatencyChanged" />
                            <TextBlock x:Uid="LatencyHint" Style="{StaticResource Hint}" MaxWidth="600" HorizontalAlignment="Left" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <ComboBox x:Name="DscpCombo" x:Uid="DscpCombo" MinWidth="360" SelectionChanged="DscpChanged" />
                            <TextBlock x:Uid="DscpHint" Style="{StaticResource Hint}" MaxWidth="600" HorizontalAlignment="Left" />
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
