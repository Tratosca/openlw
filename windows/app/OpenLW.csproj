<Project Sdk="Microsoft.NET.Sdk">
  <!-- OpenLW for Windows: WinUI 3 configuration app (unpackaged, self-contained, x64 and ARM64). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>OpenLW</RootNamespace>
    <AssemblyName>OpenLW</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Generates OpenLW.pri (compiled XAML, Strings\<language>\Resources.resw) for the unpackaged app. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Resource fallback language: English. -->
    <DefaultLanguage>en-US</DefaultLanguage>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- LibraryImport (named pipe P/Invoke) generates unsafe marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.5.0</Version>
    <Company>François Brille</Company>
    <Product>OpenLW</Product>
    <Copyright>Copyright 2026 François Brille (Tratosca)</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.*" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- Unmodified ASIO Compatible logo (Steinberg usage guidelines: shown near ASIO mentions). -->
    <Content Include="..\..\docs\assets\asio-compatible-logo.png" Link="Assets\asio-compatible-logo.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
