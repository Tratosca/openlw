<?xml version="1.0" encoding="utf-8"?>
<!-- OpenLW for Windows installer (WiX Toolset 5 or later), one MSI per architecture (x64, arm64).
     Built by build-msi.ps1, which passes DaemonExe, DriverDir, AppDir and Version. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:fire="http://wixtoolset.org/schemas/v4/wxs/firewall">
  <Package Name="OpenLW" Manufacturer="François Brille" Version="$(Version)"
           UpgradeCode="{B029ECEC-58E9-4697-91CB-A38FD927504C}" Scope="perMachine"
           Language="1033" Codepage="1252" InstallerVersion="500">
    <MajorUpgrade DowngradeErrorMessage="A newer version of OpenLW is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="ARPURLINFOABOUT" Value="https://francois-brille.fr" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="OpenLW">
        <Directory Id="APPFOLDER" Name="App" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <!-- Working directory and binaries of the custom actions (WiX defines only referenced standard folders). -->
    <StandardDirectory Id="System64Folder" />

    <Feature Id="Main" Title="OpenLW" AllowAbsent="no">
      <ComponentGroupRef Id="Service" />
      <ComponentGroupRef Id="Driver" />
      <ComponentGroupRef Id="App" />
    </Feature>

    <!-- Local group whose members may change the configuration without elevation;
         the installing user is added (name resolved from UserSID). Removed on uninstall.
         Square brackets are MSI property syntax: literal ones are escaped as [\[] and [\]]. -->
    <CustomAction Id="CreateEditGroup" Directory="System64Folder" Execute="deferred" Impersonate="no" Return="ignore"
                  ExeCommand="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -Command &quot;net localgroup 'OpenLW Users' /add /comment:'Can change the OpenLW configuration' 2>$null; $u = (New-Object Security.Principal.SecurityIdentifier '[UserSID]').Translate([\[]Security.Principal.NTAccount[\]]).Value; net localgroup 'OpenLW Users' $u /add&quot;" />
    <CustomAction Id="DeleteEditGroup" Directory="System64Folder" Execute="deferred" Impersonate="no" Return="ignore"
                  ExeCommand="&quot;[System64Folder]net.exe&quot; localgroup &quot;OpenLW Users&quot; /delete" />
    <InstallExecuteSequence>
      <Custom Action="CreateEditGroup" Before="StartServices" Condition="NOT REMOVE" />
      <Custom Action="DeleteEditGroup" After="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>

  <!-- Network service: LocalSystem (duplicates the shared section into host processes, qWAVE DSCP). -->
  <Fragment>
    <ComponentGroup Id="Service" Directory="INSTALLFOLDER">
      <Component Id="DaemonComponent">
        <File Id="lw_daemon" Source="$(DaemonExe)" Name="lw-daemon.exe" KeyPath="yes">
          <!-- Livewire and AES67 multicast reception: local subnet only. -->
          <fire:FirewallException Id="FwDaemon" Name="OpenLW (network service)" Protocol="udp" Scope="localSubnet" Profile="all" />
        </File>
        <ServiceInstall Name="OpenLW" DisplayName="OpenLW"
                        Description="OpenLW network service: Livewire and AES67 audio, audio driver."
                        Type="ownProcess" Start="auto" ErrorControl="normal" Account="LocalSystem" Arguments="service" />
        <ServiceControl Id="OpenLWService" Name="OpenLW" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
        <util:EventSource Name="OpenLW" Log="Application" EventMessageFile="[#lw_daemon]" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <!-- Audio driver (ASIO, GPLv3): in-process COM server, listed by host applications as “OpenLW”. -->
  <Fragment>
    <ComponentGroup Id="Driver" Directory="INSTALLFOLDER">
      <Component Id="DriverComponent">
        <File Id="driver_dll" Source="$(DriverDir)\OpenLWDriver.dll" KeyPath="yes" />
        <RegistryKey Root="HKCR" Key="CLSID\{4F9DD084-E18A-4E0E-8D38-C2854029E846}">
          <RegistryValue Type="string" Value="OpenLW" />
          <RegistryKey Key="InprocServer32">
            <RegistryValue Type="string" Value="[#driver_dll]" />
            <RegistryValue Type="string" Name="ThreadingModel" Value="Apartment" />
          </RegistryKey>
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="SOFTWARE\ASIO\OpenLW">
          <RegistryValue Type="string" Name="CLSID" Value="{4F9DD084-E18A-4E0E-8D38-C2854029E846}" />
          <RegistryValue Type="string" Name="Description" Value="OpenLW" />
        </RegistryKey>
      </Component>
<?if $(sys.BUILDARCH) = arm64 ?>
      <!-- OpenLWDriver.dll is an ARM64X forwarder to these: x64 host applications emulated on ARM64. -->
      <Component Id="DriverArm64Component">
        <File Id="driver_arm64" Source="$(DriverDir)\OpenLWDriver_arm64.dll" KeyPath="yes" />
      </Component>
      <Component Id="DriverX64Component">
        <File Id="driver_x64" Source="$(DriverDir)\OpenLWDriver_x64.dll" KeyPath="yes" />
      </Component>
<?endif?>
    </ComponentGroup>
  </Fragment>

  <!-- Configuration app (self-contained WinUI 3 publish folder). -->
  <Fragment>
    <ComponentGroup Id="App" Directory="APPFOLDER">
      <Component Id="AppExeComponent">
        <File Id="openlw_exe" Source="$(AppDir)\OpenLW.exe" KeyPath="yes">
          <!-- Headphone preview: multicast reception from the local subnet. -->
          <fire:FirewallException Id="FwApp" Name="OpenLW (headphone preview)" Protocol="udp" Scope="localSubnet" Profile="all" />
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="OpenLW" WorkingDirectory="APPFOLDER"
                    Description="Livewire network, patching and audio driver" Advertise="yes" />
        </File>
      </Component>
      <Files Include="$(AppDir)\**">
        <Exclude Files="$(AppDir)\OpenLW.exe" />
      </Files>
    </ComponentGroup>
  </Fragment>
</Wix>
